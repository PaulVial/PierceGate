# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=piercegate
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=piercegate
DATABASE_URL=postgresql://piercegate:your-secure-db-password@postgres:5432/piercegate

# ─── LiteLLM ──────────────────────────────────────────────────────────────────
# Master key to access the LiteLLM admin API and proxy endpoints
LITELLM_MASTER_KEY=sk-piercegate-change-me

# ─── LLM Providers ────────────────────────────────────────────────────────────
# Add only the providers you use — leave others empty
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# ─── Dashboard ────────────────────────────────────────────────────────────────
# Secret used to sign session cookies — generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-64-char-hex-string

# Admin credentials for the dashboard login
ADMIN_USER=admin
ADMIN_PASSWORD=your-secure-admin-password

# ─── Alerts — optional, sprint 2 ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
SLACK_WEBHOOK_URL=
